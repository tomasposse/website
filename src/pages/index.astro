---
import Augmented from "../components/Augmented.astro";
import Product from "../components/Product.astro";
import "../styles/global.css";

import Text from "../components/Shared/Text.astro";

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="./favicon.svg" />
		<link rel="icon" href="./favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<title>Tomás Posse</title>
	</head>
	<body>
		<div style="width: 100%;">
			<div style="display: flex;  min-height: 100svh; flex-direction: column;" >
				<nav class="top-nav">
					<div class="nav-text-wrap">
						<Text text="Tomás Posse | @tokyyto" fontSize={24} colorVariation={1} />
					</div>
				</nav>
				<Product />
			</div>
			<div style="min-height: 100svh; display: flex; flex-direction: column; background: linear-gradient(to bottom, #ecfeff 0%, #ADD8E6 100%);">
				<Augmented />
			</div>

		</div>
	</body>
</html>

<style>
	.top-nav {
		padding: 8px 24px;
		border-bottom: 1px solid #a3a9b1;
		background: #e1e7f1;
	}

	.nav-text-wrap {
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin: auto;
	}
	.nav-name {
		font-family: var(--font-global);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--font-color);
	}
</style>
