---
import Carousel from "../components/Aug/Carousel.astro";
import Work2 from "../components/Aug/Work2.astro";

---

<style>
    .total2 {
        width: 100%;
        min-height: 100dvh;

        padding: 40px 20px 200px 20px;

        display: flex;
        justify-content: center;
        align-items: center;
    }
    .colss {
        display: flex;
        flex-direction: column;
        gap: 0px;
        max-width: 1000px;
        min-width: 0;
        /* background-color: lightblue; */
    }
</style>

<div class="total2">
    <div class="colss">
        <p style="font-size: 2rem;">Augmented Reality</p>

        <!-- <div style="margin: auto;">
            <Color text="augmented reality" fontSize={30} />
        </div> -->

        <div style="margin-top: 20px;">
            <div style="display: flex; gap: 20px; flex-wrap: wrap;" >
                <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 30px;" >
                    <!-- <Text words={["6", "billion", "impressions", "on", "Meta"]} fontSize={54} flyDuration={600} /> -->
                    <div style="width: 100%; min-width: 300px; display: flex; justify-content: space-between;" >
                        <Work2 />
                    </div>
                </div>

            </div>
        </div>
        <div style="margin-top: 40px;">
            <div style="display: flex; flex-direction: column; gap: 40px;">
                <div style="margin: auto; width: 100%;">
                    <div style="display: flex; width: 100%;">
                        <div style="width: 300px;; display: flex; flex-direction: column; margin: auto; gap: 10px; padding: 20px 0; border-radius: 10px; box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px; " >
                            <p style="margin: auto;">Clients</p>
                            <div style="width: 100%;">
                                <Carousel />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div style="margin-top: 20px;">
            <div style="display: flex;  gap: 40px; flex-direction: column;">
                <img src="/images/cck.webp" alt="" class="img" style=" object-fit: cover; aspect-ratio: 1.5/1; height: 200px; border-radius: 10px; margin: auto;" />
                <div style="display: flex; flex-direction: column; gap: 20px; margin: auto;" >
                    <p style="font-size: 2rem; margin-bottom: 8px;"> Our Partnership with Meta </p>
                    <div style="display: flex; gap: 20px;">
                        <img src="/images/meta.webp" alt="Company Logo" style="width: 100px; height: 100px;" />
                        <p style="font-size: 1rem; max-width: 400px;"> As an official Meta Partner Studio, we engineered augmented reality experiences across Instagram, Facebook, and Messenger until the platform shut down in January 2025 </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
