---
interface Props {
  text?: string;
  fontSize?: number;
  colorVariation?: number;
  class?: string;
}

const {
  text = "design is how it works",
  fontSize = 72,
  colorVariation = 1,
  class: className = "",
} = Astro.props;
---

<div
  class={["design-tiles-host", className].join(" ").trim()}
  data-design-tiles
  data-text={text}
  data-font-size={fontSize}
  data-color-variation={colorVariation}
></div>

<script>
  import { DesignTiles } from "./Text/engine";

  const hosts = document.querySelectorAll<HTMLElement>("[data-design-tiles]");

  /* Reduced-motion support is currently disabled: this tiles animation always
     runs regardless of the user's `prefers-reduced-motion` setting. Re-enable
     by restoring a `const reduce = window.matchMedia("(prefers-reduced-motion:
     reduce)").matches` check and branching to tiles.renderStill() when set. */

  const instances: DesignTiles[] = [];

  hosts.forEach((host) => {
    const tiles = new DesignTiles(host, {
      text: host.getAttribute("data-text") ?? undefined,
      fontSize: Number(host.getAttribute("data-font-size") ?? 72),
      colorVariation: Number(host.getAttribute("data-color-variation") ?? 1),
    });
    instances.push(tiles);
    tiles.start();
  });

  if (document.fonts?.ready) {
    document.fonts.ready.then(() => {
      instances.forEach((t) => t.refreshFont());
    });
  }

  window.addEventListener("beforeunload", () => {
    instances.forEach((t) => t.destroy());
  });
</script>

<style>
  .design-tiles-host {
    position: relative;
    /* Keep the requested font size until the containing block is too small.
       Text.astro scales itself down in that case (see engine.ts). */
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    height: auto;
    overflow: visible;
  }
  .design-tiles-host > div {
    max-width: 100%;
  }
</style>
